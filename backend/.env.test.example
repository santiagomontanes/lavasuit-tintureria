# Copiar a .env.test antes de correr los tests.
# La DB de test DEBE ser distinta de la de desarrollo.
# El nombre debe incluir la palabra "test" (jest.setup.js lo verifica).

DATABASE_URL="mysql://lavasuit_user:CAMBIAR_PASSWORD@localhost:3306/lavasuit_test_db"
JWT_SECRET="jest-test-secret"
JWT_EXPIRES_IN="1h"
NODE_ENV=test
CORS_ORIGIN="*"

# Opcional: subir los límites para que no estorben si los activas en tests.
RATE_LIMIT_LOGIN_MAX=1000
RATE_LIMIT_REGISTRO_MAX=1000
