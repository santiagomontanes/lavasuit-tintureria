# Conexión a MySQL — formato Prisma
DATABASE_URL="mysql://lavasuit_user:CAMBIAR_PASSWORD@localhost:3306/lavasuit_db"

# Secreto para firmar JWT. OBLIGATORIO. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CAMBIAR_POR_CADENA_LARGA_Y_ALEATORIA"
JWT_EXPIRES_IN="7d"

# Redis (opcional, no se usa todavía)
REDIS_URL="redis://localhost:6379"

PORT=3000
NODE_ENV=development

# CORS: "*" en desarrollo, lista separada por coma en producción
# Ejemplo prod: CORS_ORIGIN="https://admin.lavasuit.com,https://app.lavasuit.com"
CORS_ORIGIN="*"

# ─── Licencias (Supabase: proyecto compartido con pos-v2/admin/panel-licencias) ───
# Estas variables son SECRETAS y solo viven en el backend. Mobile/desktop
# llaman a POST /api/licencias/{activar,verificar} y este controlador las usa.
# Si no se setean, los endpoints responden 503 (Sistema de licencias no
# configurado) y el resto de la app sigue funcionando para QA local.
SUPABASE_URL="https://awutehzbhhklcgodmluq.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="CAMBIAR_POR_SERVICE_ROLE_KEY"
# Producto esperado en Supabase para LavaSuit (mismo enum que el panel)
LAVASUIT_PRODUCT_TYPE="LAUNDRY"
# Días de gracia offline antes de exigir re-verificación con servidor
LICENSE_GRACE_DAYS=7
